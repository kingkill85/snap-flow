{
  "name": "snapflow-backend",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "nodeModulesDir": true,
  "tasks": {
    "dev": "deno run --allow-all --watch src/main.ts",
    "start": "deno run --allow-all src/main.ts",
    "test": "deno test --allow-all",
    "migrate": "deno run --allow-all src/scripts/migrate.ts",
    "install": "echo 'No install needed - using Deno-native dependencies'"
  },
  "imports": {
    "hono": "npm:hono@^4.0.0",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.2.0",
    "zod": "npm:zod@^3.22.0",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "djwt": "https://deno.land/x/djwt@v3.0.2/mod.ts",
    "xlsx": "npm:xlsx@^0.18.5",
    "sqlite": "https://deno.land/x/sqlite@v3.9.1/mod.ts",
    "sharp": "npm:sharp@^0.33.0",
    "@std/assert": "jsr:@std/assert@^0.208.0"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
