{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neo Dev governed Codex execution state",
  "type": "object",
  "required": [
    "target",
    "codex_session_id",
    "phase",
    "process_generation",
    "restart_count",
    "terminal",
    "lifecycle_state"
  ],
  "properties": {
    "target": { "type": "object" },
    "codex_session_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "phase": {
      "enum": [
        "never_started",
        "starting",
        "active",
        "correctable",
        "resuming",
        "exited_resumable",
        "exited_unresumable",
        "semantic_success",
        "semantic_blocked",
        "crashed",
        "failed_closed"
      ]
    },
    "process_generation": { "type": "integer", "minimum": 0 },
    "restart_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "terminal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "semantic_outcome", "resumable"],
          "properties": {
            "exit_code": { "type": "integer" },
            "semantic_outcome": {
              "enum": ["success", "correctable", "blocked", "crashed", "invalid"]
            },
            "resumable": { "type": "boolean" }
          }
        }
      ]
    },
    "lifecycle_state": {
      "enum": ["label", "specification_ready", "spec_approved", "implementation_verified", "accepted", "archive_authorized", "archive_ci_verified", "merge_authorized", "merged_closed", "cancelled"]
    },
    "lifecycle_updated_at": { "type": ["string", "null"] },
    "spec_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "base_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "implementation_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "accepted_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "archive_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "approval_at": { "type": ["string", "null"] },
    "accepted_at": { "type": ["string", "null"] },
    "merge_authorized_at": { "type": ["string", "null"] },
    "github_evidence": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
