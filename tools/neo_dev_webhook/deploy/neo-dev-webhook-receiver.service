[Unit]
Description=SnapFlow Neo Dev GitHub webhook receiver
After=network-online.target

[Service]
Type=simple
User=neo-dev
Group=neo-dev
EnvironmentFile=/etc/neo-dev/webhook.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/neo-dev/webhook
ExecStart=/usr/bin/python3 -m neo_dev_webhook.server --host 127.0.0.1 --port 8787 --concurrency-limit 8 --read-timeout 5
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neo-dev/webhook

[Install]
WantedBy=multi-user.target
