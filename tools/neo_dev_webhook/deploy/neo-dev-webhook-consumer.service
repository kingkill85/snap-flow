[Unit]
Description=SnapFlow Neo Dev durable webhook consumer
After=network-online.target neo-dev-webhook-receiver.service

[Service]
Type=simple
User=neo-dev
Group=neo-dev
EnvironmentFile=/etc/neo-dev/webhook.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/neo-dev/webhook
ExecStart=/usr/bin/python3 -m neo_dev_webhook.consumer /var/lib/neo-dev/webhook/work.sqlite3 --max-runtime 2h --max-attempts 5
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neo-dev/webhook

[Install]
WantedBy=multi-user.target
