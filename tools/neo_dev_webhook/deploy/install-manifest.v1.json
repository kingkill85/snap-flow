{
  "version": 1,
  "deployment": "host-side-explicit",
  "concurrency": 1,
  "defaults": {"owner": "root", "group": "root"},
  "directories": [
    {"destination": "/opt/neo-dev/webhook/neo_dev_webhook", "mode": "0755"},
    {"destination": "/opt/neo-dev/lib/neo_dev_webhook", "mode": "0755"},
    {"destination": "/var/lib/neo-dev/webhook", "owner": "neo-dev", "group": "neo-dev", "mode": "0750"}
  ],
  "files": [
    {"source": "../__init__.py", "destination": "/opt/neo-dev/webhook/neo_dev_webhook/__init__.py", "mode": "0644"},
    {"source": "../automation.py", "destination": "/opt/neo-dev/webhook/neo_dev_webhook/automation.py", "mode": "0644"},
    {"source": "../server.py", "destination": "/opt/neo-dev/webhook/neo_dev_webhook/server.py", "mode": "0644"},
    {"source": "../consumer.py", "destination": "/opt/neo-dev/webhook/neo_dev_webhook/consumer.py", "mode": "0644"},
    {"source": "../remote_adapter.py", "destination": "/opt/neo-dev/lib/neo_dev_webhook/remote_adapter.py", "mode": "0644"},
    {"source": "../project_control.py", "destination": "/opt/neo-dev/lib/neo_dev_webhook/project_control.py", "mode": "0644"},
    {"source": "../__init__.py", "destination": "/opt/neo-dev/lib/neo_dev_webhook/__init__.py", "mode": "0644"},
    {"source": "../controller/neo-dev-remote-project-control", "destination": "/usr/local/bin/neo-dev-project-control", "mode": "0755"},
    {"source": "snapflow.profile.md", "destination": "/opt/data/profiles/dev/projects/snapflow.md", "mode": "0644"},
    {"source": "neo-dev-webhook-receiver.service", "destination": "/etc/systemd/system/neo-dev-webhook-receiver.service", "mode": "0644"},
    {"source": "neo-dev-webhook-consumer.service", "destination": "/etc/systemd/system/neo-dev-webhook-consumer.service", "mode": "0644"}
  ],
  "required_existing_secret_files": [
    "/etc/neo-dev/webhook.env",
    "/etc/neo-dev/ssh/snapflow-dev",
    "/etc/neo-dev/ssh/known_hosts"
  ],
  "activation": [
    "systemctl daemon-reload",
    "systemctl enable --now neo-dev-webhook-receiver.service neo-dev-webhook-consumer.service"
  ]
}
