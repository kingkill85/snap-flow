# Keep OpenSpec telemetry disabled for repository-local commands and CI.
OPENSPEC_TELEMETRY=0

# Dormant GitHub webhook handoff (do not commit real values).
SNAPFLOW_GITHUB_WEBHOOK_SECRET=
SNAPFLOW_GITHUB_REPOSITORY=owner/repository
SNAPFLOW_GITHUB_WEBHOOK_DB=/absolute/service-data/github-webhook.sqlite
SNAPFLOW_GITHUB_WEBHOOK_PORT=8787
